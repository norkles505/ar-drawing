<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ARDrawing" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/navbar_dark</item>
        <item name="colorPrimaryVariant">@color/navbar_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/mc_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/mc_bg_dark</item>
        <item name="android:statusBarColor">@color/mc_bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/navbar_dark</item>
