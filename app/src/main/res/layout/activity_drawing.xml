<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- overlayView ocupa TODO el parent, igual que previewView, sin depender del panel -->
    <com.ardrawing.app.camera.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.ardrawing.app.camera.RulerView
        android:id="@+id/rulerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.ardrawing.app.camera.BubbleLevelView
        android:id="@+id/bubbleLevelView"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:visibility="gone"
        android:elevation="6dp"
        app:layout_constraintBottom_toTopOf="@id/controlsPanel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="12dp" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@color/mc_popup_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@android:color/transparent"
            android:contentDescription="Atras"
            android:tint="#AAAAAA" />

        <ImageButton
            android:id="@+id/btnFlash"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_flash"
            android:background="@android:color/transparent"
            android:contentDescription="Flash"
            android:tint="#FFFFFF"
            android:alpha="0.5"
            android:layout_marginStart="6dp" />

        <ImageButton
            android:id="@+id/btnUndo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_undo"
            android:background="@android:color/transparent"
            android:contentDescription="Deshacer"
            android:tint="#FFFFFF"
            android:alpha="0.5"
            android:layout_marginStart="6dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />


        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_record"
            android:background="@android:color/transparent"
            android:contentDescription="Grabar timelapse"
            android:tint="#FFFFFF"
            android:alpha="0.5"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/btnSaveProject"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_save"
            android:background="@drawable/bg_save_button"
            android:contentDescription="Guardar proyecto"
            android:tint="#FFFFFF" />

    </LinearLayout>

    <!-- Fila de miniaturas de referencia -->
    <HorizontalScrollView
        android:id="@+id/referencesScrollView"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:scrollbars="none"
        android:elevation="6dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/referencesContainer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="4dp" />

    </HorizontalScrollView>

    <!-- tvImageSize flotante sobre la camara, esquina superior derecha bajo topbar -->
    <TextView
        android:id="@+id/tvImageSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="#CC000000"
        android:padding="6dp"
        android:visibility="gone"
        android:elevation="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Panel inferior -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        android:background="@color/mc_popup_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fila opacidad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_opacity"
                android:contentDescription="Opacidad"
                android:tint="#55FFFFFF"
                android:layout_marginEnd="10dp" />

            <SeekBar
                android:id="@+id/seekbarOpacity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="@color/mc_accent"
                android:thumbTint="#FFFFFF" />

        </LinearLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="4dp" />

        <!-- Panel brillo/contraste -->
        <LinearLayout
            android:id="@+id/brightnessPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:text="Brillo"
                    android:textSize="11sp"
                    android:textColor="#55FFFFFF" />

                <SeekBar
                    android:id="@+id/seekbarBrightness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100"
                    android:progressTint="@color/mc_accent"
                    android:thumbTint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnResetBrightness"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_reset"
                    android:background="@drawable/bg_tool_button"
                    android:tint="#AAAAAA"
                    android:contentDescription="Reset brillo"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:text="Contraste"
                    android:textSize="11sp"
                    android:textColor="#55FFFFFF" />

                <SeekBar
                    android:id="@+id/seekbarContrast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100"
                    android:progressTint="@color/mc_accent"
                    android:thumbTint="#FFFFFF" />

                <ImageButton
                    android:id="@+id/btnResetContrast"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_reset"
                    android:background="@drawable/bg_tool_button"
                    android:tint="#AAAAAA"
                    android:contentDescription="Reset contraste"
                    android:layout_marginStart="6dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Panel zoom -->
        <LinearLayout
            android:id="@+id/zoomPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="Zoom"
                android:textSize="11sp"
                android:textColor="#55FFFFFF" />

            <SeekBar
                android:id="@+id/seekbarZoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/mc_accent"
                android:thumbTint="#FFFFFF" />

            <TextView
                android:id="@+id/tvZoomLevel"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="1.0x"
                android:textSize="11sp"
                android:textColor="#AAFFFFFF"
                android:gravity="center"
                android:layout_marginStart="8dp" />

            <ImageButton
                android:id="@+id/btnZoomReset"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_reset"
                android:background="@drawable/bg_tool_button"
                android:tint="#AAAAAA"
                android:contentDescription="Reset zoom"
                android:layout_marginStart="4dp" />

        </LinearLayout>



        <!-- Panel escala imagen -->
        <LinearLayout
            android:id="@+id/scalePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="Tamaño"
                android:textSize="11sp"
                android:textColor="#55FFFFFF" />

            <ImageButton
                android:id="@+id/btnScaleDown"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_scale_down"
                android:background="@drawable/bg_tool_button"
                android:tint="#FFFFFF"
                android:contentDescription="Reducir imagen" />

            <TextView
                android:id="@+id/tvScaleValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="1.00x"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnScaleUp"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_scale_up"
                android:background="@drawable/bg_tool_button"
                android:tint="@color/mc_accent"
                android:contentDescription="Agrandar imagen" />

            <ImageButton
                android:id="@+id/btnScaleReset"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_reset"
                android:background="@drawable/bg_tool_button"
                android:tint="#AAAAAA"
                android:contentDescription="Reset tamaño"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <!-- Fila de herramientas -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp">

                <!-- Fase 1: posicionar la imagen de referencia -->

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnScale"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_scale_up"
                        android:contentDescription="Tamaño imagen"
                        android:alpha="0.5" />
                    <TextView style="@style/ToolLabel" android:text="escala" />
                </LinearLayout>

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnRotate"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_rotate"
                        android:contentDescription="Rotar" />
                    <TextView style="@style/ToolLabel" android:text="rotar" />
                </LinearLayout>

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnMirror"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_flip"
                        android:contentDescription="Espejo"
                        android:alpha="0.5" />
                    <TextView style="@style/ToolLabel" android:text="espejo" />
                </LinearLayout>

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnLock"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="Bloquear"
                        android:alpha="0.5" />
                    <TextView style="@style/ToolLabel" android:text="bloquear" />
                </LinearLayout>

                <!-- Fase 2: ajustar visual para calcar -->

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnBrightness"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_brightness"
                        android:contentDescription="Brillo"
                        android:alpha="0.5" />
                    <TextView style="@style/ToolLabel" android:text="brillo" />
                </LinearLayout>

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnGrid"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_grid"
                        android:contentDescription="Cuadricula"
                        android:alpha="0.5" />
                    <TextView style="@style/ToolLabel" android:text="cuadrícula" />
                </LinearLayout>

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnInvert"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_invert"
                        android:contentDescription="Invertir colores"
                        android:alpha="0.5" />
                    <TextView style="@style/ToolLabel" android:text="invertir" />
                </LinearLayout>

                <!-- Fase 3: ayudas de medición -->

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnRuler"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_ruler"
                        android:contentDescription="Regla"
                        android:alpha="0.5" />
                    <TextView style="@style/ToolLabel" android:text="regla" />
                </LinearLayout>

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnLevel"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_level"
                        android:contentDescription="Nivel"
                        android:alpha="0.5" />
                    <TextView style="@style/ToolLabel" android:text="nivel" />
                </LinearLayout>

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnSize"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_size"
                        android:contentDescription="Tamano"
                        android:alpha="0.5" />
                    <TextView style="@style/ToolLabel" android:text="medida" />
                </LinearLayout>

                <!-- Fase 4: cámara -->

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnZoom"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_magnifier"
                        android:contentDescription="Zoom"
                        android:alpha="0.5" />
                    <TextView style="@style/ToolLabel" android:text="zoom" />
                </LinearLayout>

                <!-- Fase 5: sesión -->

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnTimer"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_timer"
                        android:contentDescription="Timer"
                        android:alpha="0.5" />
                    <TextView style="@style/ToolLabel" android:text="temporizador" />
                </LinearLayout>

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnNightMode"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_night"
                        android:contentDescription="Modo nocturno"
                        android:alpha="0.5" />
                    <TextView style="@style/ToolLabel" android:text="noche" />
                </LinearLayout>

                <!-- Fase 6: acción global/destructiva, al final para evitar toques accidentales -->

                <LinearLayout style="@style/ToolWrap">
                    <ImageButton
                        android:id="@+id/btnReset"
                        style="@style/ToolButton2"
                        android:src="@drawable/ic_reset"
                        android:contentDescription="Reset" />
                    <TextView style="@style/ToolLabel" android:text="reset" />
                </LinearLayout>

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- Toggle panel — encima del panel, pegado a la derecha -->
    <ImageButton
        android:id="@+id/btnToggleControls"
        android:layout_width="32dp"
        android:layout_height="24dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="2dp"
        android:src="@drawable/ic_toggle_arrow"
        android:background="@drawable/bg_toggle_pill"
        android:tint="#666666"
        android:contentDescription="Toggle controles"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controlsPanel" />

</androidx.constraintlayout.widget.ConstraintLayout>
